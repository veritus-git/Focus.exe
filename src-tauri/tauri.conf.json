{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Focus.exe",
  "version": "0.1.0",
  "identifier": "com.focus.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Focus.exe - 8-Bit Fake OS Kiosk",
        "width": 1920,
        "height": 1080,
        "center": true,
        "fullscreen": true,
        "alwaysOnTop": true,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
